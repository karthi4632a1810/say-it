{
  "name": "say-it",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"pnpm --filter @say-it/backend dev\" \"wait-on http://127.0.0.1:3000/health -t 120000 && pnpm --filter @say-it/frontend dev\"",
    "ssl:setup": "pnpm --filter @say-it/frontend ssl:setup",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "typecheck": "pnpm run -r typecheck",
    "db:migrate": "pnpm --filter @say-it/backend db:migrate",
    "db:seed": "pnpm --filter @say-it/backend db:seed",
    "db:generate": "pnpm --filter @say-it/backend db:generate"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "wait-on": "^9.0.10"
  }
}
