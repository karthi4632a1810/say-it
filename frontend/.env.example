# API + Socket.IO URL seen by the browser.
# On your PC only: leave unset (defaults to http://localhost:3000).
# For phone/other laptop on same WiFi, use your PC's LAN IP:
# VITE_API_URL=http://192.168.1.110:3000

# Giphy GIF picker — get a free key at https://developers.giphy.com/
# VITE_GIPHY_API_KEY=your_giphy_api_key

# VITE_API_URL=http://192.168.1.110:3000
# VITE_GIPHY_API_KEY=FjRm9d4RaDx9zZqxffkGEkMWWIlz7vWJ