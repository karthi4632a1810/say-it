generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

enum MessageContentType {
  TEXT
  MARKDOWN
  SYSTEM
}

enum MessageStatusType {
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  MENTION
  DM
  MEETING
  ANNOUNCEMENT
  SYSTEM
}

enum MeetingRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum MeetingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum AnnouncementType {
  COMPANY
  DEPARTMENT
  EMERGENCY
}

enum EmbeddingSourceType {
  MESSAGE
  FILE
  ANNOUNCEMENT
  MEETING_NOTE
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  displayName     String    @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  jobTitle        String?   @map("job_title")
  departmentId    String?   @map("department_id")
  managerId       String?   @map("manager_id")
  phone           String?
  bio             String?
  timezone        String?   @default("UTC")
  location        String?
  isActive        Boolean   @default(true) @map("is_active")
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  mfaSecret       String?   @map("mfa_secret")
  mfaBackupCodes  String[]  @map("mfa_backup_codes")
  loginAttempts   Int       @default(0) @map("login_attempts")
  lockedUntil     DateTime? @map("locked_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  lastActiveAt    DateTime? @map("last_active_at")

  department       Department?          @relation("DepartmentMembers", fields: [departmentId], references: [id])
  manager          User?                @relation("UserManager", fields: [managerId], references: [id])
  directReports    User[]               @relation("UserManager")
  skills           UserSkill[]
  sessions         UserSession[]
  userRoles        UserRole[]
  sentMessages     Message[]            @relation("MessageSender")
  notifications    Notification[]
  uploadedFiles    File[]
  organizedMeetings Meeting[]           @relation("MeetingOrganizer")
  authoredAnnouncements Announcement[]
  auditLogs        AuditLog[]
  conversationMembers ConversationMember[]
  messageReactions MessageReaction[]
  messageStatuses  MessageStatus[]
  messageStars     MessageStar[]
  meetingParticipants MeetingParticipant[]
  announcementReads AnnouncementRead[]
  aiSearchHistory  AiSearchHistory[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id")
  roleId       String   @map("role_id")
  departmentId String?  @map("department_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedBy   String?  @map("assigned_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserSkill {
  userId String @map("user_id")
  skill  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skill])
  @@map("user_skills")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String?  @map("parent_id")
  headUserId  String?  @map("head_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  parent        Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children      Department[] @relation("DepartmentHierarchy")
  members       User[]       @relation("DepartmentMembers")
  conversations Conversation[]
  meetings      Meeting[]
  announcements Announcement[]

  @@map("departments")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  deviceName       String?  @map("device_name")
  deviceType       String?  @map("device_type")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  isActive         Boolean  @default(true) @map("is_active")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  lastUsedAt       DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Conversation {
  id              String           @id @default(uuid())
  type            ConversationType
  name            String?
  description     String?
  departmentId    String?          @map("department_id")
  isPrivate       Boolean          @default(false) @map("is_private")
  isArchived      Boolean          @default(false) @map("is_archived")
  createdAt       DateTime         @default(now()) @map("created_at")
  createdBy       String?          @map("created_by")
  lastMessageId   String?          @map("last_message_id")
  lastActivityAt  DateTime         @default(now()) @map("last_activity_at")

  department Department?          @relation(fields: [departmentId], references: [id])
  members    ConversationMember[]
  messages   Message[]
  files      File[]

  @@index([lastActivityAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId   String   @map("conversation_id")
  userId           String   @map("user_id")
  role             String   @default("MEMBER")
  joinedAt         DateTime @default(now()) @map("joined_at")
  lastReadAt       DateTime? @map("last_read_at")
  notificationPref String   @default("ALL") @map("notification_pref")
  isMuted          Boolean  @default(false) @map("is_muted")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id              String             @id @default(uuid())
  conversationId  String             @map("conversation_id")
  senderId        String             @map("sender_id")
  content         String?
  contentType     MessageContentType @default(TEXT) @map("content_type")
  parentMessageId String?            @map("parent_message_id")
  isEdited        Boolean            @default(false) @map("is_edited")
  isDeleted       Boolean            @default(false) @map("is_deleted")
  deletedBy       String?            @map("deleted_by")
  forwardedFrom   String?            @map("forwarded_from")
  isPinned        Boolean            @default(false) @map("is_pinned")
  pinnedAt        DateTime?          @map("pinned_at")
  pinnedBy        String?            @map("pinned_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id])
  parent       Message?            @relation("MessageThread", fields: [parentMessageId], references: [id])
  replies      Message[]           @relation("MessageThread")
  attachments  MessageAttachment[]
  statuses     MessageStatus[]
  reactions    MessageReaction[]
  edits        MessageEdit[]
  stars        MessageStar[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageStar {
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_stars")
}

model MessageAttachment {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  fileId    String @map("file_id")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id])

  @@map("message_attachments")
}

model MessageStatus {
  messageId    String            @map("message_id")
  userId       String            @map("user_id")
  status       MessageStatusType
  deliveredAt  DateTime?         @map("delivered_at")
  readAt       DateTime?         @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_status")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model MessageEdit {
  id              String   @id @default(uuid())
  messageId       String   @map("message_id")
  previousContent String   @map("previous_content")
  editedAt        DateTime @default(now()) @map("edited_at")
  editedBy        String   @map("edited_by")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_edits")
}

model File {
  id                String   @id @default(uuid())
  name              String
  originalName      String   @map("original_name")
  mimeType          String   @map("mime_type")
  sizeBytes         BigInt   @map("size_bytes")
  storageKey        String   @map("storage_key")
  bucketName        String   @map("bucket_name")
  uploadedBy        String   @map("uploaded_by")
  conversationId    String?  @map("conversation_id")
  version           Int      @default(1)
  previousVersionId String?  @map("previous_version_id")
  isDeleted         Boolean  @default(false) @map("is_deleted")
  createdAt         DateTime @default(now()) @map("created_at")

  uploader     User                @relation(fields: [uploadedBy], references: [id])
  conversation Conversation?       @relation(fields: [conversationId], references: [id])
  attachments  MessageAttachment[]

  @@map("files")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Meeting {
  id              String            @id @default(uuid())
  title           String
  description     String?
  organizerId     String            @map("organizer_id")
  departmentId    String?           @map("department_id")
  startsAt        DateTime          @map("starts_at")
  endsAt          DateTime          @map("ends_at")
  recurrenceType  MeetingRecurrence @default(ONCE) @map("recurrence_type")
  recurrenceRule  String?           @map("recurrence_rule")
  location        String?
  meetingUrl      String?           @map("meeting_url")
  status          MeetingStatus     @default(SCHEDULED)
  createdAt       DateTime          @default(now()) @map("created_at")

  organizer    User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  department   Department?          @relation(fields: [departmentId], references: [id])
  participants MeetingParticipant[]
  notes        MeetingNote?

  @@map("meetings")
}

model MeetingParticipant {
  meetingId    String     @map("meeting_id")
  userId       String     @map("user_id")
  rsvpStatus   RsvpStatus @default(PENDING) @map("rsvp_status")
  attended     Boolean    @default(false)
  respondedAt  DateTime?  @map("responded_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@map("meeting_participants")
}

model MeetingNote {
  id        String   @id @default(uuid())
  meetingId String   @unique @map("meeting_id")
  content   String   @default("")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_notes")
}

model Announcement {
  id           String           @id @default(uuid())
  title        String
  content      String
  type         AnnouncementType
  authorId     String           @map("author_id")
  departmentId String?          @map("department_id")
  isEmergency  Boolean          @default(false) @map("is_emergency")
  expiresAt    DateTime?        @map("expires_at")
  isPublished  Boolean          @default(false) @map("is_published")
  publishedAt  DateTime?        @map("published_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  author     User               @relation(fields: [authorId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  reads      AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@map("audit_logs")
}

model Embedding {
  id          String              @id @default(uuid())
  sourceType  EmbeddingSourceType @map("source_type")
  sourceId    String              @map("source_id")
  chunkIndex  Int                 @map("chunk_index")
  chunkText   String              @map("chunk_text")
  embedding   Unsupported("vector(768)")
  metadata    Json?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([sourceType, sourceId])
  @@map("embeddings")
}

model AiSearchHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  query     String
  answer    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_search_history")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}
