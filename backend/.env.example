# # Application
# NODE_ENV=development
# PORT=3000
# FRONTEND_URL=http://localhost:5173,http://192.168.1.110:5173

# # Database (Docker Compose defaults)
# DATABASE_URL=postgresql://sayit:sayit_dev_password@localhost:5433/sayit

# # Redis
# REDIS_URL=redis://localhost:6379

# # JWT
# JWT_SECRET=change-me-to-a-long-random-string-in-production
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d

# # MinIO
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=sayit-files
# MINIO_USE_SSL=false

# # AI — Groq for chat/summarization (set LLM_PROVIDER=groq)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key
# GROQ_LLM_MODEL=llama-3.3-70b-versatile

# # Ollama (local AI — or embeddings when using Groq for LLM)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=qwen3.5:latest
# OLLAMA_LLM_THINK=false
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# # Email (optional — Phase 3)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=noreply@sayit.local
